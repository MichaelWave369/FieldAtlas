{
  "name": "field-atlas-study",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "vite build && node scripts/release-stamp.mjs",
    "preview": "vite preview --host 0.0.0.0",
    "test": "node --test tests/*.test.js",
    "catalog:sync": "node scripts/sync-public-pages.mjs",
    "launch:preflight": "node scripts/launch-preflight.mjs",
    "test:e2e": "playwright test",
    "release:status": "node scripts/release-readiness.mjs --check",
    "release:gate": "node scripts/release-readiness.mjs --gate",
    "live:verify": "node scripts/live-site-audit.mjs",
    "test:live": "playwright test --config playwright.live.config.js"
  },
  "dependencies": {
    "lucide-react": "^0.468.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.7.0",
    "vite": "^6.3.0",
    "@playwright/test": "^1.56.0",
    "@axe-core/playwright": "^4.14.0"
  }
}
